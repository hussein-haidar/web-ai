# =============================================
# Environment variables untuk Netlify serverless backend
# Salin file ini menjadi .env LOKAL saat development:
#   cp .env.example .env        (atau buat manual)
#
# Untuk Netlify: set variabel ini di Netlify Dashboard
#   (Site > Site settings > Environment variables)
# JANGAN commit nilai asli ke repository!
# =============================================

# Neon PostgreSQL connection string (super-important untuk fungsi api.js)
# Format:
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Gunakan "connection string" dari Neon console (atau build STR from
# config.php). Contoh nilai PSEUDO (bukan asli):
#   postgresql://neondb_owner:SECRET@ep-xxx-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Wajib: HARUS SAMA dengan JWT_SECRET di config.php (php backend)
# Generate secara acak: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=GENERATE_RANDOM_64_HEX_CHARS_HERE

# CORS allow-list (koma pemisah). Format: scheme://host[:port]
# localhost/127.0.0.1 selalu diperbolehkan dari browser dev.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://magical-stardust-0e0cd9.netlify.app,https://startling-squirrel-62e710.netlify.app

# Google OAuth client ID (harus sama dengan google-auth-config.js)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
